# Copy to .env and change what you need. Real environment variables override .env.
# Relative paths are resolved against the project folder.

# Obsidian vault to index (read-only). WSL path to the Windows folder.
VAULT_PATH=/mnt/c/Users/user/obsidian-vault

# ChromaDB storage folder and collection name
CHROMA_PATH=chroma_db
COLLECTION_NAME=vault

# sentence-transformers embedding model (changing it requires a full re-index)
EMBED_MODEL=all-MiniLM-L6-v2

# Max words per chunk. Notes are split on headings; longer sections are split
# further. Keep under ~180 words: the embedding model reads only 256 tokens.
CHUNK_SIZE=120

# Number of results returned by /query when top_k is not given
DEFAULT_TOP_K=3

# Number of note sections given to the LLM by /ask and ask.py
RAG_TOP_K=5

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Seconds to wait for an answer. A cold start (model not in RAM) on CPU with
# little free memory took >120s; warm answers take ~10-30s.
OLLAMA_TIMEOUT=300
# How long Ollama keeps the model loaded after a request (avoids cold starts)
OLLAMA_KEEP_ALIVE=30m
# Sampling temperature: 0 = deterministic, sticks closest to the notes
OLLAMA_TEMPERATURE=0

# Log level for stderr logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
